-- Lets check how many verifications exist


SELECT * FROM identity.verifications;-- Result 20 rows exist it

-- How many are approved verificatons?
SELECT * FROM identity.verifications
WHERE status = 'Approved';
-- Result: 15 rows
-- lets use the COUNT function to get this
SELECT COUNT(*) FROM identity.verifications
WHERE status = 'Approved';


--How many are rejected ?

SELECT COUNT(*) FROM identity.verifications
WHERE status = 'Rejected';   -- 5 rows for rejected ones

-- Now lets see average processing time of the verifications 
SELECT AVG(processing_time_seconds)
FROM identity.verifications;  -- 12.10 seconds

-- Now if we want to know total time consumed processing verifications, we use like this:
SELECT SUM(processing_time_seconds)
FROM identity.verifications -- 242 second, that means all the verifications took this time to process.

-- lets see the fastest verification happened
SELECT MIN(processing_time_seconds)
FROM identity.verifications; -- that is the one which took 8 seconds
 

-- What about the slowest one
SELECT MAX(processing_time_seconds)
FROM identity.verifications; -- it took 15 seconds
















