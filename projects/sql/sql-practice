-- Newest Users First
SELECT * FROM identity.users
ORDER BY created_at DESC;

-- LIMIT
-- First 5 Users
SELECT * FROM identity.users 
LIMIT 5;

-- last 5 Users
SELECT * FROM identity.users 
ORDER BY created_at DESC
LIMIT 5;

