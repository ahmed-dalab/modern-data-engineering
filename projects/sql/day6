-- Organization Report 

-- get total user per org
SELECT 
    o.name  As Organisations,
	COUNT(u.id) AS Total_users
FROM identity.organizations o
LEFT JOIN identity.users u
ON o.id = u.organization_id
GROUP BY o.name;






-- get total verification per org
SELECT 
     o.name AS organisation_name,
	 COUNT(v.id) AS total_verifications
FROM identity.organizations o
LEFT JOIN identity.users u 
ON o.id = u.organization_id
LEFT JOIN identity.verifications v
ON u.id = v.user_id
GROUP BY o.name;








-- get approved verifications per org


SELECT 
     o.name AS organisation_name,
	 COUNT(v.id) AS total_verifications
FROM identity.organizations o
LEFT JOIN identity.users u 
ON o.id = u.organization_id
LEFT JOIN identity.verifications v
ON u.id = v.user_id
WHERE v.status = 'Rejected'
GROUP BY o.name;


-- show only the organizations having more than 5 verifications 
SELECT
    o.name AS organization_name,
    COUNT(v.id) AS total_verifications
FROM identity.organizations o
LEFT JOIN identity.users u
ON o.id = u.organization_id
LEFT JOIN identity.verifications v
ON u.id = v.user_id
GROUP BY o.name
HAVING COUNT(v.id) > 5;




















