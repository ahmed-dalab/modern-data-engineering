-- Today we will learn group by and having

-- without group by it gives us total verifications 
SELECT COUNT(*) 
FROM identity.verifications;

-- with group by 

SELECT 
    status, 
	COUNT(*) AS total_verifications
FROM identity.verifications
GROUP BY status;

-- Report by verification type 

SELECT 
    verification_type,
	COUNT (*) AS total_verifications
FROM identity.verifications
GROUP BY verification_type;

-- Average processing time by status
SELECT 
    status,
	AVG(processing_time_seconds) AS Processing_time
FROM identity.verifications
GROUP BY status;



-- Full verification summary by status
SELECT 
      verification_type,
	  AVG(processing_time_seconds) AS average_time,
	  MIN(processing_time_seconds) AS fastest_time,
	  MAX(processing_time_seconds) AS slowest_time
FROM identity.verifications
GROUP BY verification_type;



-- Having 

SELECT 
    verification_type,
	COUNT(*) AS total_requests
FROM identity.verifications
GROUP BY verification_type
HAVING COUNT(*) > 5;
	


